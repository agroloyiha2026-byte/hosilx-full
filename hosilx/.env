# Faqat placeholderlar. Haqiqiy qiymatlarni hosting "Environment/Secrets" bo'limiga kiriting; bu faylni Git'ga haqiqiy qiymat bilan yozmang.

TELEGRAM_BOT_TOKEN=...            # @BotFather beradi
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=...          # service_role: FAQAT shu bot muhitida. Flutter/sayt/GitHub'ga YOZILMAYDI

# polling (oddiy) yoki webhook (bepul hostingda tavsiya)
BOT_MODE=polling
WEBHOOK_URL=                      # webhook rejimida: https://SIZNING-BOT.onrender.com
WEBHOOK_SECRET=                   # webhook rejimida: 16-256 belgi (harf, raqam, _ -)
PORT=10000

WEB_URL=                          # ixtiyoriy: https://sayt-manzili (ulash ko'rsatmasida chiqadi)
REDIS_URL=                        # ixtiyoriy: FSM holatini saqlash uchun

# AI (ixtiyoriy). Bo'sh bo'lsa bot "AI sozlanmagan" deydi
ANTHROPIC_API_KEY=
AI_MODEL=                         # model nomi kodda qat'iy yozilmagan: o'zingiz kiriting
AI_DAILY_LIMIT=50

# migration10 (kengaytirilgan moliya turkumlari) bazada qo'llangan bo'lsagina true
FINANCE_EXTENDED_CATEGORIES=false
LOG_LEVEL=INFO

# Bepul Render'da xizmat uxlab qolmasligi uchun bot o'z /health manzilini chaqiradi.
# Render RENDER_EXTERNAL_URL ni o'zi beradi; boshqa hostingda KEEPALIVE_URL ni qo'lda yozing. O'chirish: KEEPALIVE=off
KEEPALIVE_URL=
KEEPALIVE_INTERVAL=600            # 60..840 soniya
# Eski botdagi BOT_TOKEN nomi ham qabul qilinadi (TELEGRAM_BOT_TOKEN o'rniga)
